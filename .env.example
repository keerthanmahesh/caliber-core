# Caliber Core Environment Variables Template

# Server Port and Profile (Render dynamically injects PORT)
PORT=8087
SPRING_PROFILES_ACTIVE=prod

# GitHub Packages Authentication (required for Gradle to fetch security library)
GITHUB_ACTOR=your-github-username
GITHUB_TOKEN=your-github-personal-access-token

# MongoDB Connection
MONGODB_URI=your-mongodb-connection-string
MONGODB_DATABASE=caliber

# JWT Secret & Security
JWT_SECRET=your-base64-encoded-jwt-secret-key-at-least-32-bytes
JWT_EXPIRY_MINUTES=30
SERVICE_EXPIRY_DAYS=1

# Cookie & CORS Flags
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax
CORS_ALLOWED_ORIGINS=*

# AI Engine Configuration (Ollama / Gemini)
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_BASE_URL=
OLLAMA_TIMEOUT_SECONDS=120
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=
GEMINI_TIMEOUT_SECONDS=120
AI_MAX_BODY_CHARS=10000

# Gmail API Configuration
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_REDIRECT_URI=
GMAIL_POLL_INTERVAL_MS=600000
GMAIL_POLL_ENABLED=false
GMAIL_AUTO_ARCHIVE=false
GMAIL_SCOPE=
GMAIL_AUTH_URL=
GMAIL_TOKEN_URL=
GMAIL_TOKEN_EXPIRY_SECONDS=3600
GMAIL_MAX_RESULTS=50
